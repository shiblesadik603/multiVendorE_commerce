NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/auth_db?schema=public
JWT_ACCESS_SECRET=change-me-access-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
INTERNAL_JWT_SECRET=change-me-internal-at-least-32-characters
